# =============================================================================
# SiteComply — environment variables
# Copy to ".env" for local development. In production these are supplied by
# Azure App Service application settings / Azure Key Vault references.
# NEVER commit a real ".env" file or hard-code any of these values in source.
# =============================================================================

# --- Application -------------------------------------------------------------
# Public base URL of the running app (used for SSO redirect URIs and links).
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Azure Database for PostgreSQL Flexible Server) -----------------
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# For local dev you may point this at a local Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitecomply?schema=public"

# --- Admin auth: Microsoft Azure AD (MSAL) -----------------------------------
# From your Azure AD App Registration (admin sign-in via Microsoft SSO).
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Must match a Redirect URI registered on the app, e.g. {APP_BASE_URL}/api/auth/callback
AZURE_AD_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Secret used to sign admin/worker session cookies (generate a long random value).
SESSION_SECRET=""

# --- Worker auth: SMS one-time passcode --------------------------------------
# Which SMS provider to use behind the SmsProvider interface: "acs" | "twilio" | "mock"
# Use "mock" locally to log codes to the console instead of sending real texts.
SMS_PROVIDER="mock"

# Azure Communication Services (default provider)
ACS_CONNECTION_STRING=""
# The provisioned sender number in E.164 (e.g. +447700000000) or alphanumeric sender id.
ACS_SMS_SENDER=""

# Twilio (alternative provider — stub)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# One-time passcode behaviour
OTP_TTL_SECONDS="300"
OTP_LENGTH="6"

# --- CSCS Smart Check: card verification (SC-001) -----------------------------
# Which verification provider sits behind the CscsProvider interface:
#   "mock"       — deterministic local verification, no external calls (default)
#   "smartcheck" — official CSCS Smart Check service (requires partner API access)
CSCS_PROVIDER="mock"
# CSCS Smart Check partner API (only used when CSCS_PROVIDER="smartcheck").
CSCS_SMARTCHECK_API_URL=""
CSCS_SMARTCHECK_API_KEY=""
# NOTE: uploaded/photographed card images are stored in the SAME private blob
# container as Documents (see DOCS_STORAGE_* below), under a "cscs-cards/" prefix.

# --- Documents module: private Azure Blob storage ----------------------------
# Connection string for the storage account that holds document files. Files are
# stored in a PRIVATE container and only streamed to the client after RBAC +
# Assigned-Sites checks — never via a public URL.
DOCS_STORAGE_CONNECTION_STRING=""
# Container name (defaults to "documents" if unset).
DOCS_STORAGE_CONTAINER="documents"

# --- AI Summaries (Phase 1a foundation — see docs/AI_REPORT_SUMMARIES.md) -----
# Ships OFF. Nothing is user-facing yet; these configure the foundation only.
AI_SUMMARIES_ENABLED="false"
# Provider behind the AiProvider interface: "azure-openai" | "openai" | "mock".
# Defaults to "mock" (inert, no external calls) until Azure OpenAI is provisioned.
AI_PROVIDER="mock"
# Azure OpenAI (pilot production provider — UK South).
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-08-01-preview"
# Pilot role allow-list (comma-separated PlatformRole values).
AI_SUMMARY_ROLES="DIRECTOR,PROJECT_MANAGER"
# Conservative pilot usage caps.
AI_SUMMARY_DAILY_PER_USER="20"
AI_SUMMARY_MONTHLY_GLOBAL="1000"
AI_SUMMARY_MIN_INTERVAL_SECONDS="10"
AI_SUMMARY_CACHE_TTL_HOURS="24"
