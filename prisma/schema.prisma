// SiteComply — Prisma schema
//
// Target database: PostgreSQL (Azure Database for PostgreSQL Flexible Server).
// Connection comes from the DATABASE_URL environment variable — never hard-coded.
//
// Conventions:
//  - All timestamps are stored in UTC (Prisma DateTime). British formatting
//    (DD/MM/YYYY, 24h, Europe/London) is applied only at the presentation edge.
//  - Personal data is kept to the minimum needed for site compliance and is
//    deletable to satisfy UK GDPR / Data Protection Act 2018 (see Stage 12).
//  - IDs use cuid() — URL-safe, non-sequential, no information leakage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// UK CSCS (Construction Skills Certification Scheme) card types, by colour.
enum CscsCardType {
  GREEN_LABOURER //         Green — Labourer
  RED_TRAINEE //            Red — Trainee / Experienced Worker
  BLUE_SKILLED //           Blue — Skilled Worker
  GOLD_SUPERVISORY //       Gold — Advanced Craft / Supervisory
  BLACK_MANAGER //          Black — Manager
  WHITE_PROFESSIONAL //     White — Professionally / Academically Qualified Person
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

/// Category of a site Daily Bulletin (SC-002) — drives the label/badge shown to
/// workers and managers.
enum BulletinCategory {
  NOTICE //         General site notice
  ANNOUNCEMENT //   Company/site announcement
  SAFETY_ALERT //   Urgent safety alert
}

/// The kind of question presented on a digital induction checklist.
enum ChecklistItemType {
  ACKNOWLEDGEMENT //  Read-and-acknowledge statement (e.g. site rules, RAMS)
  YES_NO //           Yes/No question (e.g. "Have you been issued your PPE?")
  PPE_CONFIRM //      Confirm possession/wearing of a PPE item
}

enum SubmissionStatus {
  COMPLIANT //   All required items completed
  INCOMPLETE // Started but not all required items satisfied
}

enum AdminRole {
  OWNER //   Full control, including admin management
  ADMIN //   Manage sites, checklists and view submissions
  VIEWER //  Read-only access to dashboards and reports
}

/// Platform (office/management) user roles. The foundation for RBAC — permission
/// mappings are added in a later stage; for now the role is captured per user.
enum PlatformRole {
  DIRECTOR
  PROJECT_MANAGER
  CLIENT
  AUDITOR
  ENGINEER
  HS_CONSULTANT //         Health & Safety Consultant
  PRINCIPAL_CONTRACTOR
  SITE_MANAGER
}

/// Lifecycle status for a Platform User's access.
enum PlatformUserStatus {
  PENDING //   Added but awaiting approval — cannot sign in yet
  ACTIVE //    Approved and enabled
  DISABLED //  Access revoked / suspended
}

/// Status of a self-service Platform Access Request (from the login screen).
enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Category of a site document in the Documents module (Phase 1). Deliberately
/// minimal — four broad buckets that cover site paperwork without over-filing;
/// expand only if a genuine business need emerges. Values match the
/// DOCUMENT_CATEGORIES option list in services/documents/documentConstants.
enum DocumentCategory {
  RAMS //         Risk Assessment & Method Statement
  INSURANCE
  CERTIFICATE //  Training, plant and other certificates
  GENERAL //      Anything else (permits, toolbox talks, misc paperwork)
}

/// Lifecycle / sign-off status of a site Audit (Audits module, Phase 1). Values
/// match the AUDIT_STATUSES option list in services/audits/auditConstants.
enum AuditStatus {
  DRAFT //         Being prepared — not yet started in earnest
  IN_PROGRESS //   Inspection under way
  COMPLETED //     Finished, awaiting sign-off
  SIGNED_OFF //    Reviewed and signed off (records who + when)
}

/// Category of an audit finding (Audits Phase 2). Values match the
/// FINDING_CATEGORIES option list in services/audits/findingConstants.
enum FindingCategory {
  SAFETY //         Health & Safety
  ENVIRONMENTAL
  QUALITY
  DOCUMENTATION
  OTHER
}

/// Severity of an audit finding.
enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Lifecycle status of an audit finding.
enum FindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// Priority of a corrective action (Actions module, Phase 1). Values match the
/// ACTION_PRIORITIES option list in services/actions/actionConstants.
enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Lifecycle status of a corrective action. "Overdue" is NOT a stored status —
/// it is derived (OPEN/IN_PROGRESS with a due date in the past).
enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

/// Panels the Worker Dashboard (SC-003) can display once a worker is checked in.
/// Site managers control which of these each site shows — see SiteDashboardSetting.
/// This enum is the single contract shared by the configuration UI and the
/// dashboard renderer, and mirrors the SC-003 requirement list verbatim.
///
/// Two panels have no source system yet and are therefore OFF by default:
/// ACTIVE_PERMITS (a digital permit-to-work register is a later REV-1 item) and
/// MESSAGES (there is no worker-facing messaging/notification store). Both render
/// an honest empty state when a manager switches them on.
enum WorkerDashboardPanel {
  SITE_INFORMATION
  DAILY_BULLETIN
  ACTIVE_PERMITS
  RAMS
  SITE_DOCUMENTS
  EMERGENCY_INFORMATION
  FIRST_AIDER
  FIRE_ASSEMBLY_POINT
  SITE_CONTACTS
  OUTSTANDING_ACTIONS
  MESSAGES
  CHECK_OUT
}

/// Kind of entry in an action's activity timeline (Actions module).
enum ActionActivityType {
  CREATED //        The action was created
  COMMENT //        A user added an update/comment
  STATUS_CHANGE //  Status moved (may carry a completion note)
  ASSIGNMENT //     Assignee set or changed
}

/// Lifecycle status of a Permit to Work (SC-009). Values match the PERMIT_STATUSES
/// option list in services/permits/permitConstants. "Expired" is derived for
/// display (an APPROVED permit past its validUntil) — the stored status only moves
/// to EXPIRED if a sweep/close records it; the register is advisory and never
/// blocks check-in.
enum PermitStatus {
  SUBMITTED //     Requested by a worker, awaiting review
  UNDER_REVIEW //  A manager has started reviewing
  APPROVED //      Approved, with a validity window
  REJECTED //      Declined by a manager (reason recorded)
  CANCELLED //     Withdrawn by the worker
  EXPIRED //       Past its validUntil (may also be derived)
  CLOSED //        Work complete / permit closed out
}

/// Answer type of a permit-type question (SC-009). Mirrors ChecklistItemType; the
/// worker request wizard renders each generically so new question types/permit
/// types are pure data. Values match services/permits/permitConstants.
enum PermitQuestionType {
  ACKNOWLEDGEMENT //  Must tick to confirm
  YES_NO //           Yes / No answer
  TEXT //             Short free text
  DATE //             A date/time value
}

/// How a worker provided their induction-acceptance signature (SC-011).
enum SignatureType {
  DRAWN //  Hand-drawn on a canvas, stored as a PNG in blob storage
  TYPED //  Typed their name, rendered in a signature font (no image stored)
}

/// Kind of entry in a permit's activity timeline (SC-009). Mirrors
/// ActionActivityType; gives the worker-facing status timeline + the audit trail.
enum PermitActivityType {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
  COMMENT
}

/// Target of an AI-generated executive summary (AI Summaries — see
/// docs/AI_REPORT_SUMMARIES.md). Phase 1a foundation only; not yet user-facing.
enum AiSummaryTarget {
  COMPLIANCE_REPORT //    per-item (report run)
  SCORECARD_REPORT //     per-item (report run)
  ORG_OVERVIEW_REPORT //  per-item (report run, Director-only)
  AUDIT //                per-item (single audit)
  AUDITS_REGISTER //      register-level (all audits in scope)
  ACTIONS_REGISTER //     register-level (all actions in scope)
}

/// Lifecycle of an AI-generated question bank for a site induction (SC-005).
enum KnowledgeCheckBankStatus {
  GENERATING //  a generation is in flight (also the lock)
  READY //       questions validated and live (or awaiting approval — see approvedAt)
  FAILED //      generation produced too few valid questions; falls back per policy
}

/// Category a knowledge-check question tests (SC-005). Drives stratified sampling
/// so every attempt spans the key induction themes.
enum KnowledgeQuestionCategory {
  SAFETY //        key safety information
  SITE_RULES //    site rules & signage
  EMERGENCY //     emergency procedures (assembly point, first aid, numbers)
  HAZARD //        significant site hazards
  GENERAL //       anything else from the induction
}

/// Progress of a worker's knowledge-check attempt (SC-005). There is no FAILED
/// state by design: the check is formative — a worker corrects wrong answers and
/// finishes at 100%, so an attempt is either still in progress or passed.
enum KnowledgeCheckAttemptStatus {
  IN_PROGRESS
  PASSED
}

/// What to do when a site has knowledge checks enabled but no READY bank at
/// check-in time (SC-005). SKIP_FLAGGED (the global default) never blocks a
/// worker on an AI outage; BLOCK requires the check.
enum InductionUnavailablePolicy {
  SKIP_FLAGGED
  BLOCK
}

/// What to do when GPS check-in validation is on for a site but a usable
/// location can't be obtained — permission denied, no fix, or poor accuracy
/// (SC-007). BLOCK (the default) stops the check-in and offers retry + the
/// manager-granted override path; ALLOW_FLAGGED lets the worker in and records
/// the check-in with `gpsUnavailable = true` for audit.
enum GpsUnavailablePolicy {
  BLOCK
  ALLOW_FLAGGED
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------

/// A trade worker who checks in to sites. Identified by UK mobile number
/// (stored in E.164 form, e.g. +447700900123) which is also their login factor.
model Worker {
  id             String        @id @default(cuid())
  fullName       String
  company        String
  mobile         String        @unique // E.164, normalised from a UK 07… number
  // Optional CSCS/ECS card details, captured where relevant.
  cscsCardNumber String?
  cscsCardType   CscsCardType?
  cscsExpiry     DateTime? // Stored as date (UTC midnight); displayed DD/MM/YYYY

  // CSCS Smart Check verification (SC-001). When a card number is captured it is
  // verified against the CSCS Smart Check service; the verified result becomes
  // the authoritative competency record (card grade, expiry and holder name are
  // taken from the verified response rather than the worker's typed guess).
  cscsScheme             String? //   Verified card scheme, e.g. "ECS", "CSCS"
  cscsVerified           Boolean   @default(false) // True only when VALID & in date
  cscsVerificationStatus String? //   VALID | EXPIRED | REVOKED | NOT_FOUND | ERROR | UNVERIFIED
  cscsVerifiedAt         DateTime? //  When the Smart Check was last run
  cscsHolderName         String? //   Name held on the card per Smart Check
  cscsQualifications     Json? //      Competency/qualification records from Smart Check
  cscsCardImagePath      String? //    Private blob path of the uploaded/photographed card

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions            Submission[]
  /// SMS audit rows addressed to this worker (cleared on erasure).
  smsMessages            SmsMessageLog[]
  /// SC-023 — this worker's site assignments.
  siteAssignments        WorkerSiteAssignment[]
  bulletinReads          SiteBulletinRead[]
  knowledgeCheckAttempts KnowledgeCheckAttempt[]
  checkInOverrides       CheckInOverride[]
  permits                Permit[]
  // SC-015: corrective actions assigned to this worker.
  assignedActions        Action[]

  @@index([company])
  @@index([cscsExpiry])
}

/// A construction site / job that workers induct onto and check in to.
model JobSite {
  id           String     @id @default(cuid())
  name         String
  addressLine1 String
  addressLine2 String?
  town         String
  postcode     String // UK postcode (validated/normalised in the service layer)
  jobReference String // Site/job reference shown to workers, e.g. "BNE-2026-014"
  status       SiteStatus @default(ACTIVE)

  // Free-text induction content shown before the checklist (site overview,
  // welfare facilities, working hours, etc.).
  inductionContent String @default("")

  // Emergency information surfaced during induction and check-in.
  fireAssemblyPoint String?
  firstAiderName    String?
  firstAiderNumber  String? // Contact number for the site first aider

  // Additional emergency detail shown on the Worker Dashboard (SC-003). All
  // optional — a panel simply omits any line the site hasn't filled in.
  firstAiderLocation String? // Where to find the first aider, e.g. "Site Office"
  nearestHospital    String? // Nearest A&E, e.g. "City Hospital – 2.4 miles"
  emergencyNumber    String? // Site emergency number; the UI falls back to 999

  // GPS check-in validation (SC-007). The check-in "point" (typically the site
  // entrance) the worker's distance is measured against, and the permitted
  // radius. GPS validation is OFF unless a manager enables it AND coordinates
  // are set — so the feature ships dark and a misconfigured site never traps a
  // worker. `gpsUnavailablePolicy` decides what happens when a location can't be
  // obtained (no permission / no fix / poor accuracy).
  gpsCheckInEnabled    Boolean              @default(false)
  latitude             Float? //             site check-in point, decimal degrees
  longitude            Float?
  checkInRadiusM       Int? //               permitted distance in metres (default applied in code)
  gpsUnavailablePolicy GpsUnavailablePolicy @default(BLOCK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByAdmin   Admin  @relation(fields: [createdByAdminId], references: [id])
  createdByAdminId String

  checklists             ComplianceChecklist[]
  submissions            Submission[]
  platformUsers          PlatformUser[]          @relation("PlatformUserSites")
  documents              Document[]
  audits                 Audit[]
  actions                Action[]
  bulletins              SiteBulletin[]
  contacts               SiteContact[]
  dashboardSettings      SiteDashboardSetting[]
  questionBanks          InductionQuestionBank[]
  knowledgeCheckAttempts KnowledgeCheckAttempt[]
  inductionConfig        SiteInductionConfig?
  siteInformation        SiteInformation?
  checkInOverrides       CheckInOverride[]
  permits                Permit[]
  cdmDutyHolders         CdmDutyHolders?
  projectDetails         SiteProjectDetails?
  keyPeople              SiteKeyPerson[]
  setupProgress          SiteSetupProgress?
  // SC-020 compliance scheduler.
  complianceSchedules    ComplianceSchedule[]
  complianceOccurrences  ComplianceOccurrence[]

  // SC-021: per-site availability overrides for permit types and activity types.
  permitTypeSettings   SitePermitTypeSetting[]
  activityTypeSettings SiteActivityTypeSetting[]

  /// SC-022 — per-user, per-site permission overrides for this site.
  userPermissions SiteUserPermission[]

  /// SC-023 — worker assignments to this site.
  workerAssignments WorkerSiteAssignment[]

  /// SC-023 — when TRUE, only invited-and-approved workers may check in here.
  ///
  /// Defaults FALSE so enabling SC-023 changes nothing on deploy. This switch
  /// can DENY SITE ACCESS, so it is Director-only and deliberately per site: an
  /// organisation turns it on one project at a time, once that project's
  /// workers have been invited.
  workerAccessEnforced Boolean @default(false)

  /// SC-021 Phase 2 — provenance of the last configuration template applied.
  /// SNAPSHOT STRINGS, deliberately not a foreign key: deleting or renaming a
  /// template must never rewrite what a site records about its own past
  /// (the same rule as SC-013's snapshot-on-use).
  appliedConfigTemplateName String?
  appliedConfigTemplateAt   DateTime?
  appliedConfigTemplateBy   String?

  @@index([status])
}

/// A Daily Bulletin (SC-002): an important site notice, announcement or safety
/// alert published by a site manager/administrator and shown to workers when they
/// check in. Belongs to exactly one site (the access boundary). A bulletin stays
/// active until archived; per-worker read state lives in SiteBulletinRead so a
/// worker can identify and dismiss new bulletins.
model SiteBulletin {
  id          String           @id @default(cuid())
  jobSite     JobSite          @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId   String
  category    BulletinCategory @default(NOTICE)
  title       String? // optional short heading
  body        String //   the notice text shown to workers
  active      Boolean          @default(true) // false = archived/retracted
  publishedAt DateTime         @default(now())

  // Who published it (nullable so a removed user doesn't orphan the bulletin);
  // denormalised name so history survives if the user is deleted.
  createdByUserId String?
  createdByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads SiteBulletinRead[]

  @@index([jobSiteId, active, publishedAt])
}

/// Per-worker acknowledgement ("I've read this") of a Daily Bulletin. Presence of
/// a row = the worker has read/dismissed that bulletin. One row per worker/bulletin.
model SiteBulletinRead {
  id             String       @id @default(cuid())
  bulletin       SiteBulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  bulletinId     String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId       String
  acknowledgedAt DateTime     @default(now())

  @@unique([bulletinId, workerId])
  @@index([workerId])
}

/// A named point of contact for a site (SC-003), e.g. "Site Manager — Michael
/// Johnson" or "Site Office". Shown to checked-in workers on the Worker Dashboard
/// Site Contacts panel and maintained by site managers. Kept separate from
/// JobSite's single first-aider fields: those describe the emergency first aider,
/// these are the day-to-day people a worker might need to call.
model SiteContact {
  id        String  @id @default(cuid())
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String
  /// The person's role/label, e.g. "Site Manager", "Site Office".
  role      String
  /// The contact's name. Optional so a location-style contact ("Site Office")
  /// can be listed with just a number.
  name      String?
  phone     String?
  /// Display order within the site's contact list (ascending).
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobSiteId, order])
}

/// Per-site visibility of one Worker Dashboard panel (SC-003). A row exists only
/// where a site manager has overridden the default: absence of a row means "use
/// the built-in default" (see services/workerDashboard/dashboardPanels). Storing
/// only overrides keeps existing sites working with no backfill, and means a
/// future change to a default automatically applies to every site that never
/// touched that panel.
model SiteDashboardSetting {
  id        String               @id @default(cuid())
  jobSite   JobSite              @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String
  panel     WorkerDashboardPanel
  enabled   Boolean

  /// Who last changed it (denormalised name so history survives user deletion).
  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobSiteId, panel])
  @@index([jobSiteId])
}

/// A versioned compliance checklist belonging to a site. Editing a checklist
/// creates a NEW version (see Stage 9) so historic submissions always reference
/// the exact content the worker agreed to. The (jobSiteId, version) pair is
/// unique; the highest version is the one currently served to workers.
model ComplianceChecklist {
  id        String   @id @default(cuid())
  jobSite   JobSite  @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String
  title     String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  items ChecklistItem[]

  @@unique([jobSiteId, version])
}

/// A single question/statement on a checklist.
model ChecklistItem {
  id          String              @id @default(cuid())
  checklist   ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  label       String
  // Optional supporting detail / helper text shown under the label.
  helpText    String?
  type        ChecklistItemType
  required    Boolean             @default(true)
  order       Int // Display order within the checklist (ascending)

  @@index([checklistId, order])
}

/// A worker's check-in to a site: the record that they completed the induction
/// and the compliance acknowledgements. `answers` holds the per-item responses
/// as JSON keyed by ChecklistItem id, capturing the checklist as it was at the
/// recorded `checklistVersion`.
model Submission {
  id               String  @id @default(cuid())
  worker           Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId         String
  jobSite          JobSite @relation(fields: [jobSiteId], references: [id])
  jobSiteId        String
  checklistVersion Int // Version of the site checklist answered (for traceability)

  answers Json @default("{}") // { [checklistItemId]: boolean | "yes" | "no" | ... }

  // Top-level compliance gates, mirrored out of `answers` for easy querying.
  ppeConfirmed      Boolean @default(false)
  rulesAcknowledged Boolean @default(false)
  safeWorkingAgreed Boolean @default(false)
  gdprConsent       Boolean @default(false) // UK GDPR consent captured at check-in

  status       SubmissionStatus @default(INCOMPLETE)
  checkedInAt  DateTime         @default(now())
  checkedOutAt DateTime? // Set when the worker checks out / leaves site

  // AI knowledge check (SC-005), mirrored out of KnowledgeCheckAttempt for easy
  // compliance reporting. `passed` is true when the check was completed at 100%;
  // `skipped` is true when the site had checks on but no bank was ready and the
  // policy was SKIP_FLAGGED (recorded for admin visibility). Both false = the
  // site had no knowledge check at the time.
  knowledgeCheckPassed  Boolean                @default(false)
  knowledgeCheckSkipped Boolean                @default(false)
  knowledgeCheckAttempt KnowledgeCheckAttempt?

  // Induction validity (SC-006). An "express" check-in is an attendance record
  // created by reusing a still-valid earlier induction (the worker did not redo
  // the induction/knowledge check). `inductionReused` marks it; the optional
  // self-relation points at the induction submission it relied on.
  inductionReused             Boolean      @default(false)
  inductionSource             Submission?  @relation("InductionReuse", fields: [inductionSourceSubmissionId], references: [id], onDelete: SetNull)
  inductionSourceSubmissionId String?
  inductionReuses             Submission[] @relation("InductionReuse")

  // GPS check-in validation (SC-007). Location captured at each action, plus the
  // outcome of the check-in validation. All nullable: a site without GPS
  // validation records none of it. Distances are metres from the site point at
  // the time of the action. `locationVerified` = inside the radius (within the
  // accuracy margin); `gpsUnavailable` = allowed in under ALLOW_FLAGGED with no
  // usable fix; `locationOverridden` = allowed in out-of-range via a manager
  // override (reason mandatory, recorded here for audit).
  checkInLat         Float?
  checkInLng         Float?
  checkInAccuracyM   Float?
  checkInDistanceM   Float?
  locationVerified   Boolean @default(false)
  gpsUnavailable     Boolean @default(false)
  locationOverridden Boolean @default(false)
  overrideByName     String?
  overrideReason     String?

  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAccuracyM Float?
  checkOutDistanceM Float?

  // Digital Induction Acceptance (SC-011). Captured on a FULL induction when the
  // site requires a signature: a declaration acceptance + a digital signature.
  // WRITE-ONCE — set at induction completion and never mutated (the signed record
  // is immutable evidence). An express (reused) check-in inherits its source
  // induction's signature and does not re-sign, so these stay null on reuses.
  declarationAccepted Boolean        @default(false)
  declarationText     String? // snapshot of the exact wording the worker agreed to
  signedName          String? // the worker's name as signed (drawn or typed)
  signatureType       SignatureType?
  signatureBlobPath   String? // drawn signature PNG in private blob storage (null for TYPED)
  signedAt            DateTime?

  @@index([jobSiteId, checkedInAt])
  @@index([workerId])
  @@index([status])
  @@index([workerId, jobSiteId, checkedInAt])
}

/// An administrator who signs in via Microsoft (Azure AD) SSO.
model Admin {
  id            String    @id @default(cuid())
  azureObjectId String    @unique // Azure AD object id (oid claim)
  email         String    @unique
  displayName   String
  role          AdminRole @default(ADMIN)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  createdSites           JobSite[]
  reviewedAccessRequests PlatformAccessRequest[]
}

/// A one-time passcode challenge for worker SMS MFA.
///
/// The code itself is never stored — only an HMAC hash — so a database leak does
/// not expose live codes. Rows are short-lived (see OTP_TTL_SECONDS) and a row's
/// `attempts` cap plus per-mobile request rate-limiting (queried over createdAt)
/// guard against brute-force and SMS-pumping abuse. Expired/consumed rows can be
/// pruned by a scheduled job (not required for v1).
model OtpChallenge {
  id         String    @id @default(cuid())
  mobile     String // E.164, normalised from a UK 07… number
  codeHash   String // HMAC-SHA256 of the code, keyed by the session secret
  expiresAt  DateTime
  attempts   Int       @default(0) // Failed verification attempts on this code
  consumedAt DateTime? // Set once verified successfully (single-use)
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

/// A platform (office/management) user who will sign in via Platform Login.
///
/// This is the foundation for RBAC and Platform Login access: it captures who a
/// user is, their organisation, contact details, role and which sites they are
/// assigned to. Authentication and permission enforcement are NOT implemented
/// here yet — a `PENDING` user is created on add and approved to `ACTIVE`.
model PlatformUser {
  id        String             @id @default(cuid())
  name      String
  company   String
  email     String             @unique // Login identifier (email method)
  mobile    String? // E.164, normalised from a UK 07… number (login method)
  role      PlatformRole
  status    PlatformUserStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Sites this user is assigned to (scope for their future RBAC permissions).
  assignedSites JobSite[] @relation("PlatformUserSites")

  /// SC-022 — permission overrides narrowing this user's role baseline per site.
  sitePermissions SiteUserPermission[]

  reportExports ReportExportLog[]

  // The self-service access request this user was created from (if any).
  accessRequest PlatformAccessRequest?

  // Documents this user uploaded (Documents module).
  uploadedDocuments Document[]

  // Audits this user created / signed off (Audits module).
  createdAudits   Audit[] @relation("AuditCreatedBy")
  signedOffAudits Audit[] @relation("AuditSignedOffBy")

  // AI summaries this user generated (AI Summaries — accountability log).
  aiSummaries AiSummary[]

  // Per-user read state for in-app notifications.
  notificationReads  NotificationRead[]
  // SC-015: actions assigned to this platform user (fallback assignee).
  assignedActions    Action[]            @relation("ActionAssignee")
  // SC-016: notification events addressed to this user.
  notificationEvents NotificationEvent[] @relation("NotificationRecipient")

  @@index([status])
  @@index([company])
}

/// Per-user read state for in-app notifications. Notifications are derived (e.g.
/// document-expiry reminders), so there is no notification row to flag — instead
/// the presence of a row here means "user U has read the notification identified
/// by `key`". Absent = unread. The key encodes the notification identity incl.
/// its reminder level, so escalating to a new threshold reads as a fresh unread.
model NotificationRead {
  id     String       @id @default(cuid())
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  key    String
  readAt DateTime     @default(now())

  @@unique([userId, key])
  @@index([userId])
}

/// Audit log of report exports (UK-GDPR accountability for worker-level data).
/// One row per successful export; viewing the log is Admin-only.
model ReportExportLog {
  id             String       @id @default(cuid())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformUserId String
  role           PlatformRole // Role at time of export
  reportType     String // Report id, e.g. "attendance", "cscs-expiring"
  format         String // "csv" (PDF later)
  siteIds        Json // string[] of the site ids in scope for this export
  dateFrom       DateTime? // Report period start (if the report is date-ranged)
  dateTo         DateTime?
  rowCount       Int // Number of data rows exported
  createdAt      DateTime     @default(now())

  @@index([reportType, createdAt])
  @@index([platformUserId])
}

/// A self-service request for Platform access, submitted from the login screen
/// when the entered email/mobile doesn't match an existing Platform User. Admins
/// review these (Pending → Approved / Rejected). Approving a request runs the
/// approval workflow, which creates and activates a Platform User and links it
/// back here (createdPlatformUser) along with the approving admin + timestamp.
model PlatformAccessRequest {
  id          String              @id @default(cuid())
  fullName    String
  companyName String
  email       String // lower-cased; login identifier the requester used
  mobile      String // E.164, normalised from a UK 07… number
  reason      String? // optional free-text reason for access
  status      AccessRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  reviewedAt  DateTime? // set when moved out of PENDING

  // Who reviewed it (the admin who approved/rejected), for accountability.
  reviewedByAdmin   Admin?  @relation(fields: [reviewedByAdminId], references: [id])
  reviewedByAdminId String?

  // The Platform User created by approving this request (1-1). Null until approved.
  createdPlatformUser   PlatformUser? @relation(fields: [createdPlatformUserId], references: [id])
  createdPlatformUserId String?       @unique

  @@index([status, createdAt])
  @@index([email])
}

/// A site document in the Documents module (Phase 1): method statements, RAMS,
/// permits, certificates and general paperwork. Each document belongs to exactly
/// one site, which is the access boundary — a viewer only sees documents for
/// sites in their scope (Director = all; others = assigned). The file itself
/// lives in private Azure Blob storage (never a public URL); `blobPath` is its
/// key within the container. Versioning and expiry tracking are intentionally
/// out of scope for Phase 1.
model Document {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    DocumentCategory
  // Owning site — the access boundary for site-scoping.
  jobSite     JobSite          @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId   String

  // Optional expiry date (UTC midnight of the chosen day). Drives the
  // Valid / Expiring soon / Expired status shown across the module. Null = the
  // document does not expire.
  expiresAt DateTime?

  // Stored file metadata. The bytes live in Azure Blob storage at `blobPath`.
  fileName  String // original upload filename, for display + download
  mimeType  String
  sizeBytes Int
  blobPath  String @unique // key within the private container

  // Who uploaded it (nullable so a deleted user doesn't orphan the document).
  uploadedBy       PlatformUser? @relation(fields: [uploadedByUserId], references: [id])
  uploadedByUserId String?
  // Denormalised uploader name so history survives if the user is removed.
  uploadedByName   String?

  // Audits that reference this document (Audits module — many-to-many).
  audits Audit[] @relation("AuditDocuments")

  // SC-017 photo annotation. The ORIGINAL upload is never overwritten: an
  // annotated copy is stored as its own row linked back here, so an audit record
  // always retains what the camera actually captured.
  annotated          Boolean @default(false)
  originalDocumentId String?
  /// Vector annotation list (shapes, arrows, text, colours) for the annotated
  /// copy, so annotations can be REOPENED and edited. The flattened image stays
  /// authoritative for display and print; this is the editable source.
  annotationData     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobSiteId, category, createdAt])
  @@index([category])
  @@index([jobSiteId, expiresAt])
  @@index([originalDocumentId])
}

/// A site audit / inspection (Audits module, Phase 1). Each audit belongs to
/// exactly one site — the access boundary for site-scoping (Director = all;
/// others = assigned sites). It captures the headline audit record: title,
/// description, free-text observations, an optional overall score (0–100) and a
/// lifecycle/sign-off status, and can reference existing uploaded Documents.
/// Findings, corrective actions and photo uploads are intentionally out of
/// scope for Phase 1.
model Audit {
  id           String      @id @default(cuid())
  title        String
  description  String?
  observations String?
  overallScore Int? // 0–100 overall score, optional
  status       AuditStatus @default(DRAFT)

  // Owning site — the access boundary for site-scoping.
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  // Who created it (nullable so a removed user doesn't orphan the audit);
  // name denormalised so history survives if the user is deleted.
  createdBy       PlatformUser? @relation("AuditCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?
  createdByName   String?

  // Sign-off record — set when status becomes SIGNED_OFF, cleared if reopened.
  signedOffBy       PlatformUser? @relation("AuditSignedOffBy", fields: [signedOffByUserId], references: [id])
  signedOffByUserId String?
  signedOffByName   String?
  signedOffAt       DateTime?

  // Existing documents this audit references (many-to-many).
  documents Document[] @relation("AuditDocuments")

  // Findings raised during this audit (Phase 2).
  findings AuditFinding[]

  // SC-013: the audit's checklist of things to inspect, copied from a template at
  // creation (or added ad-hoc). Ordered.
  items AuditItem[]

  // SC-013: provenance snapshot of the template used to create this audit. Copied
  // once at creation; template edits never change this record (snapshot-on-use).
  sourceTemplateId      String?
  sourceTemplateName    String?
  sourceTemplateVersion Int?

  // SC-014: weighted sections this audit's items are grouped under, copied from
  // the template at creation (snapshot-on-use, same rule as items).
  sections AuditSection[]

  // SC-014: named score ranges, used only when scoringMethod is CUSTOM.
  scoreBands AuditScoreBand[]

  // SC-014 scoring configuration. Ships DARK: `scoringEnabled` defaults false, so
  // existing audits keep the manual `overallScore` and behave exactly as before.
  scoringEnabled     Boolean       @default(false)
  scoringMethod      ScoringMethod @default(PERCENTAGE)
  /// Maximum points available across all sections (the mockup's "Total Possible Score").
  totalPossibleScore Int           @default(100)
  /// Minimum points required to pass.
  passingScore       Int           @default(80)
  showAsPercentage   Boolean       @default(true)
  roundScores        Boolean       @default(true)

  /// SC-014 computed results, written by auditScoringService — never hand-edited.
  /// Distinct from the legacy manual `overallScore`, which is retained for audits
  /// created before scoring existed (and whenever scoringEnabled is false).
  calculatedScore   Int?
  calculatedPercent Int?
  calculatedPassed  Boolean?
  scoredAt          DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  // SC-020 compliance scheduler.
  complianceOccurrences ComplianceOccurrence[]

  @@index([jobSiteId, status, createdAt])
  @@index([status])
}

/// SC-014 — how an audit's overall score is produced.
enum ScoringMethod {
  /// Points earned over points available, expressed as a percentage.
  PERCENTAGE
  /// The whole audit simply passes or fails; no percentage is presented.
  PASS_FAIL
  /// Percentage scoring, then mapped to named bands (see AuditScoreBand).
  CUSTOM
}

/// SC-014 — how an individual checklist item contributes to the score.
/// NOTE: "mandatory" is deliberately NOT a member here. A mandatory question is a
/// separate boolean flag on the item, because the requirement is that it "must be
/// passed regardless of the overall score" — a gate, orthogonal to how the item
/// scores. That lets a question be both weighted AND mandatory.
enum QuestionScoringRule {
  /// Carries points; contributes proportionally to its section.
  WEIGHTED
  /// All-or-nothing: full points on pass, zero on fail.
  PASS_FAIL
  /// Recorded for information only — excluded from both earned and available points.
  INFO_ONLY
}

/// SC-014 — the auditor's answer to a checklist item.
enum ItemResult {
  PASS
  FAIL
  /// Not applicable — excluded from the available-points denominator.
  NA
}

/// A weighted group of checklist items on an audit (SC-014), e.g. "Site Access &
/// Security". Copied from an AuditTemplateSection at audit creation, so later
/// template edits never alter a historic audit's structure or score.
model AuditSection {
  id            String @id @default(cuid())
  audit         Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId       String
  name          String
  /// Share of totalPossibleScore this section contributes. Across one audit these
  /// must sum to 100 — enforced in auditScoringService, not by the database.
  weightPercent Int    @default(0)
  order         Int

  items AuditItem[]

  @@index([auditId, order])
}

/// A single checklist item on an audit (SC-013) — a thing the auditor inspects.
/// Copied from an AuditTemplateItem at audit creation, or added ad-hoc. SC-014
/// layered scoring configuration and the auditor's result onto it.
model AuditItem {
  id       String          @id @default(cuid())
  audit    Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId  String
  label    String
  helpText String?
  category FindingCategory @default(OTHER)
  /// Auditor's free-text note against this item (optional in v1).
  note     String?
  order    Int

  // SC-014 — grouping. Nullable so SC-013 audits (which have no sections) still
  // load; ungrouped items are treated as an implicit "Ungrouped" section.
  section   AuditSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId String?

  // SC-014 — scoring configuration for this item.
  scoringRule QuestionScoringRule @default(WEIGHTED)
  /// Relative weight of this item within its section (WEIGHTED/PASS_FAIL only).
  points      Int                 @default(1)
  /// Must be passed for the audit to pass, whatever the percentage says.
  mandatory   Boolean             @default(false)

  // SC-014 — the auditor's answer. Null until answered.
  result         ItemResult?
  pointsAwarded  Int?
  answeredAt     DateTime?
  answeredByName String?

  @@index([auditId, order])
  @@index([sectionId, order])
}

/// A named score range for the CUSTOM scoring method (SC-014), e.g. "Gold 90–100".
/// Belongs to either an audit or a template — exactly one of the two FKs is set.
model AuditScoreBand {
  id         String         @id @default(cuid())
  audit      Audit?         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId    String?
  template   AuditTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String?

  label    String
  minScore Int
  maxScore Int
  /// Design-token name (e.g. "safe", "hivis", "danger") — never a raw hex value,
  /// so bands re-theme with the rest of the design system.
  tone     String @default("brand")
  order    Int    @default(0)

  @@index([auditId, order])
  @@index([templateId, order])
}

/// A reusable Audit Template (SC-013) — an ORGANISATION-LEVEL library entry that
/// standardises an audit format across sites. Not site-scoped; usage (a created
/// audit) is site-scoped. `version` bumps on edit for provenance/traceability;
/// because audits COPY the items at creation, template edits never alter historic
/// audits. `isSystem` marks the seeded starter templates.
model AuditTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  version     Int     @default(1)
  active      Boolean @default(true)
  isSystem    Boolean @default(false)
  order       Int     @default(0)

  createdByUserId String?
  createdByName   String?

  items AuditTemplateItem[]

  // SC-014: weighted sections and scoring config travel WITH the template, so a
  // template captures a whole audit format (structure + how it scores), not just
  // a list of questions. Copied onto the audit at creation (snapshot-on-use).
  sections   AuditTemplateSection[]
  scoreBands AuditScoreBand[]

  scoringEnabled     Boolean       @default(false)
  scoringMethod      ScoringMethod @default(PERCENTAGE)
  totalPossibleScore Int           @default(100)
  passingScore       Int           @default(80)
  showAsPercentage   Boolean       @default(true)
  roundScores        Boolean       @default(true)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // SC-020 compliance scheduler.
  complianceSchedules ComplianceSchedule[]

  /// SC-021: sites that have overridden this activity type's availability.
  siteSettings SiteActivityTypeSetting[]

  /// SC-021 Phase 2.
  configTemplateItems SiteConfigTemplateItem[]
  orgPolicy           OrgServicePolicy?

  @@index([active, order])
}

/// A weighted section on an audit template (SC-014). Copied onto an AuditSection
/// when an audit is created from the template.
model AuditTemplateSection {
  id            String        @id @default(cuid())
  template      AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId    String
  name          String
  weightPercent Int           @default(0)
  order         Int

  items AuditTemplateItem[]

  @@index([templateId, order])
}

/// One reusable check item on an audit template (SC-013). Copied onto an
/// AuditItem when an audit is created from the template.
model AuditTemplateItem {
  id              String           @id @default(cuid())
  template        AuditTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId      String
  label           String
  helpText        String?
  category        FindingCategory  @default(OTHER)
  defaultSeverity FindingSeverity?
  order           Int

  // SC-014 — grouping + scoring, copied onto the AuditItem at audit creation.
  section     AuditTemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId   String?
  scoringRule QuestionScoringRule   @default(WEIGHTED)
  points      Int                   @default(1)
  mandatory   Boolean               @default(false)

  @@index([templateId, order])
  @@index([sectionId, order])
}

/// A finding raised during an audit (Audits Phase 2): an issue with a title,
/// description, category, severity, status and optional due date, plus a
/// free-text corrective action. Findings inherit the parent audit's site scope
/// (there is no site column — access is resolved via `audit.jobSiteId`). Photo
/// uploads remain out of scope.
model AuditFinding {
  id          String          @id @default(cuid())
  audit       Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId     String
  title       String
  description String?
  category    FindingCategory @default(OTHER)
  severity    FindingSeverity @default(MEDIUM)
  status      FindingStatus   @default(OPEN)
  dueDate     DateTime? // stored as UTC midnight of the chosen date

  // Free-text corrective action for this finding.
  correctiveAction String?

  // Who raised it (name denormalised so history survives user deletion).
  createdByUserId String?
  createdByName   String?

  // Set when the finding is CLOSED, cleared if reopened.
  closedAt DateTime?

  // Corrective actions generated from this finding (Actions module).
  actions Action[]

  // Uploaded evidence (photos / documents) supporting the finding.
  evidence FindingEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId, status])
  @@index([status])
}

/// A photo or document uploaded as evidence against an audit finding. Mirrors
/// ActionEvidence: bytes live in the existing private Documents blob container
/// (under a `findings/<id>/` prefix), only the pointer + metadata are stored.
/// Cascade-deleted with the finding; site-scoping inherited from the parent
/// audit. Stays linked to the finding for its lifetime, incl. when the finding
/// generates a corrective action (the action links back to the finding).
model FindingEvidence {
  id        String       @id @default(cuid())
  finding   AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String

  blobPath String
  fileName String
  mimeType String
  size     Int

  uploadedByUserId String?
  uploadedByName   String?

  // SC-017 photo annotation. The ORIGINAL upload is never overwritten: an
  // annotated copy is stored as its own row linked back here, so an audit record
  // always retains what the camera actually captured.
  annotated          Boolean @default(false)
  originalEvidenceId String?
  /// Vector annotation list (shapes, arrows, text, colours) for the annotated
  /// copy, so annotations can be REOPENED and edited. The flattened image stays
  /// authoritative for display and print; this is the editable source.
  annotationData     Json?

  createdAt DateTime @default(now())

  @@index([findingId, createdAt])
  @@index([originalEvidenceId])
}

/// A corrective action / follow-up task (Actions module, Phase 1). Each action
/// belongs to exactly one site — the access boundary for site-scoping. It can
/// optionally originate from an audit finding (auditFinding), giving a central
/// register of everything that needs doing across sites. "Overdue" is derived
/// (OPEN/IN_PROGRESS with a past due date), not a stored status.
model Action {
  id          String         @id @default(cuid())
  title       String
  description String?
  priority    ActionPriority @default(MEDIUM)
  status      ActionStatus   @default(OPEN)
  dueDate     DateTime? // stored as UTC midnight of the chosen date

  // SC-015: the responsible person. `assignedTo` remains the denormalised NAME
  // snapshot (so history survives a worker/user being removed, and legacy
  // free-text assignees stay readable); the FKs below identify who it actually
  // is. Exactly one FK is set for actions created from SC-015 onward — legacy
  // actions have neither and keep their free text.
  assignedTo        String?
  assignedToCompany String?

  assignedWorker   Worker? @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  assignedWorkerId String?

  // Fallback assignee when a site has no inducted workers (SC-015 decision):
  // a platform user assigned to that site.
  assignedPlatformUser   PlatformUser? @relation("ActionAssignee", fields: [assignedPlatformUserId], references: [id], onDelete: SetNull)
  assignedPlatformUserId String?

  // Owning site — the access boundary for site-scoping.
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  // Optional origin: the audit finding that generated this action.
  auditFinding   AuditFinding? @relation(fields: [auditFindingId], references: [id], onDelete: SetNull)
  auditFindingId String?

  // Who created it (name denormalised so history survives user deletion).
  createdByUserId String?
  createdByName   String?

  // Set when the action is COMPLETED, cleared if reopened. A completion note is
  // required when marking Completed; the latest one is mirrored here for display
  // (the full history lives in the activity timeline).
  completedAt    DateTime?
  completionNote String?

  // Chronological activity timeline (creation, assignment, status, comments).
  activities ActionActivity[]

  // Uploaded evidence (photos / documents) supporting the action.
  evidence ActionEvidence[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // SC-016: notifications raised about this action.
  notificationEvents NotificationEvent[]

  @@index([jobSiteId, status, dueDate])
  @@index([status, dueDate])
  @@index([assignedWorkerId])
  @@index([assignedPlatformUserId])
}

/// A photo or document uploaded as evidence against an Action. The bytes live in
/// the existing private Documents blob container (under an `actions/<id>/` prefix);
/// only the pointer + metadata are stored here. Cascade-deleted with the action;
/// site-scoping is inherited from the parent action's owning site.
model ActionEvidence {
  id       String @id @default(cuid())
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String

  blobPath String
  fileName String
  mimeType String
  size     Int

  // Who uploaded it (name denormalised so it survives user deletion).
  uploadedByUserId String?
  uploadedByName   String?

  // SC-017 photo annotation. The ORIGINAL upload is never overwritten: an
  // annotated copy is stored as its own row linked back here, so an audit record
  // always retains what the camera actually captured.
  annotated          Boolean @default(false)
  originalEvidenceId String?
  /// Vector annotation list (shapes, arrows, text, colours) for the annotated
  /// copy, so annotations can be REOPENED and edited. The flattened image stays
  /// authoritative for display and print; this is the editable source.
  annotationData     Json?

  createdAt DateTime @default(now())

  @@index([actionId, createdAt])
  @@index([originalEvidenceId])
}

/// One entry in an action's activity timeline: creation, assignment change,
/// status change (optionally with a completion note) or a user comment. Together
/// these give a chronological history on the action detail page.
model ActionActivity {
  id       String             @id @default(cuid())
  action   Action             @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String
  type     ActionActivityType

  // Free text — the comment body or completion note (nullable for pure events).
  note      String?
  // For STATUS_CHANGE / ASSIGNMENT: the previous and new values (labels/enum).
  fromValue String?
  toValue   String?

  // Who performed it (name denormalised so history survives user deletion).
  authorUserId String?
  authorName   String?

  createdAt DateTime @default(now())

  @@index([actionId, createdAt])
}

/// Permit to Work — type catalogue (SC-009). DATA-DRIVEN so new permit types are
/// added by inserting rows (seed or a future admin UI), never a schema change or
/// redeploy. Seeded with the REV-1 standard types (Hot Works, Working at Height,
/// etc.). `key` is the stable identifier; `referencePrefix` builds permit refs.
model PermitType {
  id              String  @id @default(cuid())
  key             String  @unique // e.g. HOT_WORKS
  name            String // e.g. "Hot Works"
  referencePrefix String // e.g. "HW" — used in the permit reference code
  iconKey         String  @default("permit") // worker icon name
  description     String?
  order           Int     @default(0)
  active          Boolean @default(true)
  /// System types ship in the seed; kept so a future admin UI can distinguish
  /// built-ins from bespoke site-added types.
  isSystem        Boolean @default(true)

  questions PermitTypeQuestion[]
  permits   Permit[]

  /// SC-021: sites that have overridden this type's availability.
  siteSettings SitePermitTypeSetting[]

  /// SC-021 Phase 2.
  templateItems SiteConfigTemplateItem[]
  orgPolicy     OrgServicePolicy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

/// A question attached to a permit type (SC-009). Rendered generically by the
/// worker request wizard (see services/permits/permitFlow), so adding questions
/// is pure data. A worker's answers are stored on Permit.answers keyed by id.
model PermitTypeQuestion {
  id           String             @id @default(cuid())
  permitType   PermitType         @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  permitTypeId String
  label        String
  helpText     String?
  type         PermitQuestionType
  required     Boolean            @default(true)
  order        Int

  @@index([permitTypeId, order])
}

/// A Permit to Work request/record (SC-009). Raised by a worker for the site they
/// are checked into, reviewed and approved/rejected by a site manager. An advisory
/// register — it never blocks check-in. Actor names are denormalised so the audit
/// trail survives user deletion; the full chronological history lives in
/// PermitActivity.
model Permit {
  id        String @id @default(cuid())
  reference String @unique // human code, e.g. "HW-260728-001"

  // Owning site — the access boundary for site-scoping.
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  // Requesting worker.
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId String

  // Permit type (relation kept for questions; key/name snapshotted for history).
  permitType     PermitType @relation(fields: [permitTypeId], references: [id], onDelete: Restrict)
  permitTypeId   String
  permitTypeKey  String // snapshot of PermitType.key at request time
  permitTypeName String // snapshot of PermitType.name at request time

  status PermitStatus @default(SUBMITTED)

  // Core request details.
  workActivity   String
  workLocation   String?
  proposedStart  DateTime?
  proposedFinish DateTime?
  // Per-question answers, keyed by PermitTypeQuestion id (boolean | 'yes'|'no' | string).
  answers        Json

  // Requested (worker name denormalised).
  submittedByName String
  submittedAt     DateTime @default(now())

  // Review / approval (manager actor denormalised).
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?

  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?
  validFrom        DateTime?
  validUntil       DateTime?

  rejectedByUserId String?
  rejectedByName   String?
  rejectedAt       DateTime?
  rejectionReason  String?

  cancelledAt DateTime?

  closedByUserId String?
  closedByName   String?
  closedAt       DateTime?

  activities PermitActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobSiteId, status])
  @@index([workerId, status])
}

/// One entry in a permit's activity timeline (SC-009). Mirrors ActionActivity —
/// gives the worker-facing status timeline and the full "who did what when" audit
/// trail. Append-only.
model PermitActivity {
  id       String             @id @default(cuid())
  permit   Permit             @relation(fields: [permitId], references: [id], onDelete: Cascade)
  permitId String
  type     PermitActivityType

  note      String? // free text — comment / rejection reason
  fromValue String? // previous status (label)
  toValue   String? // new status (label)

  // Who performed it (name denormalised so history survives user deletion).
  // actorKind distinguishes a worker action from a platform-user action.
  actorKind    String // 'worker' | 'platform'
  authorUserId String?
  authorName   String?

  createdAt DateTime @default(now())

  @@index([permitId, createdAt])
}

/// Audit + cache record for an AI-generated executive summary (AI Summaries,
/// Phase 1a foundation — see docs/AI_REPORT_SUMMARIES.md). One row per generation
/// attempt, capturing the scope snapshot, provider/model, token usage and result.
/// This is the accountability log (mirrors ReportExportLog) AND the cache store;
/// no user-facing surface consumes it yet.
model AiSummary {
  id         String          @id @default(cuid())
  targetType AiSummaryTarget
  targetKey  String // audit id, or a stable hash of the report target + filters

  // Who generated it (nullable + SetNull so the audit trail survives user deletion).
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  platformUserId String?
  role           PlatformRole // role at generation time (scope snapshot)

  siteIds     Json // string[] scope snapshot — the sites the summary was built from
  contextHash String // hash of the scoped input context → cache key + change detection

  provider      String // 'azure-openai' | 'openai' | 'mock'
  model         String
  promptVersion String

  summary      Json? // structured { headline, keyPoints[], risks[], recommendedFocus[] }; null on failure
  tokensPrompt Int?
  tokensOutput Int?
  status       String // 'OK' | 'FAILED'
  errorReason  String?

  createdAt DateTime @default(now())

  @@index([targetType, targetKey, createdAt])
  @@index([platformUserId, createdAt])
  @@index([createdAt])
}

/// Singleton runtime configuration for the SMS gateway (Admin → Settings →
/// Integrations). Lets admins pick the active provider and store per-provider
/// settings without a redeploy. Secret field values inside `settings` are
/// encrypted at rest (AES-256-GCM via lib/secretBox) and never returned to the
/// client. `settings` shape: { [providerId]: { [fieldKey]: value|ciphertext } }.
/// Falls back to env vars when no row exists (backward compatible).
model SmsConfig {
  id               String   @id // fixed singleton key ("sms")
  activeProvider   String   @default("mock")
  /// Master switch for outbound SMS.
  ///
  /// Defaults TRUE so adding it changes nothing — the active provider is what
  /// decides whether a real message leaves. Turning it OFF suppresses every
  /// send, INCLUDING sign-in codes, so a worker cannot receive an OTP and
  /// cannot log in. The admin screen says so plainly; it exists for a billing
  /// emergency or a suspected compromise, not for routine use.
  sendingEnabled   Boolean  @default(true)
  settings         Json     @default("{}")
  updatedByAdminId String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Singleton company / organisation profile + branding (Admin → Settings →
/// Company). Stores the company name, support contact details and branding
/// (colours, tagline) plus a pointer to the logo blob. The logo bytes live in the
/// existing private Documents blob container (under a `branding/` prefix); only
/// the blob path + content type are stored here and the image is streamed back
/// via a serving route. Falls back to product defaults when unset.
model CompanyConfig {
  id String @id // fixed singleton key ("company")

  companyName  String?
  supportEmail String?
  supportPhone String?

  // Branding.
  primaryColor String? // hex, e.g. "#38B54A"
  accentColor  String? // hex, e.g. "#00AEEF"
  tagline      String?

  // Logo — bytes in blob storage; DB holds the pointer only.
  logoBlobPath    String?
  logoContentType String?
  logoUpdatedAt   DateTime?

  updatedByAdminId String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Singleton runtime configuration for platform notifications (Admin → Settings →
/// Notifications). Per notification type: a master enable toggle plus per-channel
/// (email / SMS) delivery preferences, stored as JSON so new types/channels are a
/// catalogue entry only. `settings` shape:
/// { [typeKey]: { enabled: bool, channels: { email: bool, sms: bool } } }.
/// Falls back to the catalogue defaults when a type is absent, so the app is safe
/// before any row exists. Consumed at runtime via getNotificationRuntimeConfig()
/// (and isNotificationEnabled/…) — future notification services read the same
/// getters, so no code changes are needed to honour admin preferences.
model NotificationConfig {
  id       String @id // fixed singleton key ("notifications")
  settings Json   @default("{}")

  updatedByAdminId String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Singleton runtime configuration for authentication (Admin → Settings →
/// Authentication). Lets admins tune OTP expiry, max verification attempts,
/// session timeout and which OTP channels are enabled without a redeploy.
/// Nullable numeric columns fall back to env vars / built-in defaults when unset,
/// so the app is safe and backward compatible before any row exists. Consumed at
/// runtime via getAuthRuntimeConfig() — future ACS / platform auth features read
/// the same getter, so no code changes are needed to honour new values.
model AuthConfig {
  id String @id // fixed singleton key ("auth")

  // OTP settings (null → env/default, clamped on read + save).
  otpTtlSeconds  Int? // worker SMS OTP validity window
  otpMaxAttempts Int? // wrong-code attempts before a challenge locks

  // Session settings.
  sessionTtlSeconds Int? // platform user session lifetime

  // Enabled OTP channels (forward-looking: email OTP not yet implemented).
  smsOtpEnabled   Boolean @default(true)
  emailOtpEnabled Boolean @default(false)

  updatedByAdminId String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Singleton runtime configuration for AI Summaries (Admin → Settings →
/// Integrations). Lets admins enable the feature, pick the active AI provider
/// and store per-provider settings + feature settings without a redeploy.
/// Secret field values inside `settings` are encrypted at rest (lib/secretBox)
/// and never returned to the client. Falls back to env when no row exists.
model AiConfig {
  id             String  @id // fixed singleton key ("ai")
  enabled        Boolean @default(false)
  activeProvider String  @default("mock")
  settings       Json    @default("{}") // { [providerId]: { [field]: value|ciphertext } }

  // Feature settings.
  allowedRoles  Json @default("[]") // PlatformRole[] permitted to use AI summaries
  dailyPerUser  Int? // per-user/day cap (null → env/default)
  monthlyGlobal Int? // org/month cap (null → env/default)

  updatedByAdminId String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// AI Generated Knowledge Checks (SC-005)
// ----------------------------------------------------------------------------

/// Per-site knowledge-check configuration (SC-005). One row per site; absence =
/// use the global defaults (services/knowledgeChecks/knowledgeCheckConstants).
/// Deliberately extensible: SC-006 will add induction validity-period fields to
/// THIS row rather than a new table. A change to which panels are shown lives in
/// SiteDashboardSetting; this row governs the knowledge check only.
model SiteInductionConfig {
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String  @id

  /// null → inherit the global default (knowledgeCheckEnabledDefault).
  knowledgeCheckEnabled  Boolean?
  /// null → inherit the global default (questionsPerAttemptDefault, 6).
  questionsPerAttempt    Int?
  /// When true, a freshly generated bank stays hidden from workers until a
  /// manager approves it (approvedAt on the bank). Default false = auto-publish.
  requireManagerApproval Boolean                     @default(false)
  /// What to do when checks are on but no READY bank exists at check-in time.
  /// null → inherit the global default (SKIP_FLAGGED).
  unavailablePolicy      InductionUnavailablePolicy?

  /// Induction validity (SC-006). How many days a completed induction for this
  /// site remains valid, so a returning worker checks in without re-inducting
  /// until it expires. null → no validity window: re-induct on every check-in
  /// (the pre-SC-006 behaviour), so the feature ships dark.
  inductionValidityDays   Int?
  /// Manager "invalidate previous inductions" cutoff (SC-006): any induction
  /// completed at or before this instant is treated as expired, forcing every
  /// worker to complete the latest induction before their next check-in.
  inductionsInvalidatedAt DateTime?
  invalidatedByName       String?

  /// Digital Induction Acceptance (SC-011). When true, a worker completing a FULL
  /// induction at this site must accept the declaration and provide a digital
  /// signature before their check-in is recorded. Ships dark: false = the
  /// pre-SC-011 tick-box completion (no signature required).
  inductionSignatureRequired Boolean @default(false)

  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Structured, worker-facing Site Information (SC-008). A dedicated 1:1 record
/// (like SiteInductionConfig) that a Site Manager maintains and that a checked-in
/// worker sees on their persistent "Site information" page, updating in real time
/// without re-induction. Kept separate from the JobSite record so it is editable
/// under the site-manager `sites:edit` permission rather than the Director-only
/// site-record gate. Emergency fields (fire assembly, first aider, A&E, emergency
/// number) deliberately stay on JobSite and are NOT duplicated here — they remain
/// managed on the site record and are only DISPLAYED read-only alongside these.
/// All fields optional so the feature ships dark: an empty section renders nothing.
model SiteInformation {
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String  @id

  /// Free text with line breaks preserved on render (no rich text in v1).
  workingHours        String?
  siteRules           String? @db.Text
  welfareFacilities   String? @db.Text
  siteHazards         String? @db.Text
  emergencyProcedures String? @db.Text

  /// SC-019 Phase 1 — further CPP narrative sections. Same kind of data as the
  /// SC-008 fields above, so they live HERE rather than in a parallel CPP model:
  /// one home means the worker-facing Site Information page and the Construction
  /// Phase Plan can never diverge.
  existingSiteRisks     String? @db.Text
  temporaryWorks        String? @db.Text
  trafficManagement     String? @db.Text
  deliveryProcedures    String? @db.Text
  accessEgress          String? @db.Text
  environmentalControls String? @db.Text
  utilitiesIsolation    String? @db.Text
  highRiskActivities    String? @db.Text
  fireArrangements      String? @db.Text

  /// Site map image, stored in the same private Azure Blob container as the
  /// Documents module (via services/documents/blobStorage). Metadata only; the
  /// bytes are streamed to a checked-in worker through an authenticated route,
  /// never a public URL. Kept off the Document table so it never appears in the
  /// Documents lists / RAMS counts.
  siteMapBlobPath  String?
  siteMapFileName  String?
  siteMapMimeType  String?
  siteMapSizeBytes Int?

  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A generated pool of knowledge-check questions for one exact induction state
/// (SC-005): a (site, checklistVersion, contentHash) triple, where contentHash
/// covers the checklist items AND the site's free-text induction + emergency
/// fields. A worker attempt samples questionsPerAttempt from the READY bank, so
/// steady-state check-ins make no live model call. Regenerated when the content
/// hash changes; the unique key means one bank per exact induction state.
model InductionQuestionBank {
  id               String  @id @default(cuid())
  jobSite          JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId        String
  checklistVersion Int
  contentHash      String

  status        KnowledgeCheckBankStatus @default(GENERATING)
  provider      String? //  'azure-openai' | 'openai' | 'mock'
  model         String?
  promptVersion String?
  error         String? //  set when status = FAILED

  /// Auto-publish (requireManagerApproval=false) sets this at generation time;
  /// otherwise a manager sets it on approval. Only an approved READY bank is
  /// served to workers.
  approvedAt     DateTime?
  approvedByName String?

  questions InductionQuestion[]
  attempts  KnowledgeCheckAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobSiteId, checklistVersion, contentHash])
  @@index([jobSiteId, status])
}

/// One multiple-choice question in a bank (SC-005). Exactly four options, exactly
/// one correct. `options` is [{ id, text }]; `correctOptionId` references one of
/// them. `sourceRef` records which induction section the question came from, for
/// the worker's "Review induction section" link. `active` false = withdrawn
/// (e.g. after a flag), so it is no longer sampled.
model InductionQuestion {
  id       String                    @id @default(cuid())
  bank     InductionQuestionBank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  bankId   String
  order    Int
  category KnowledgeQuestionCategory @default(GENERAL)

  prompt          String
  options         Json //   [{ id: string, text: string }] (length 4)
  correctOptionId String
  sourceRef       String? // label/anchor of the induction section tested
  explanation     String? // short why-this-is-correct, shown after answering

  active Boolean @default(true)

  flags QuestionFlag[]

  createdAt DateTime @default(now())

  @@index([bankId, active, order])
}

/// A worker's attempt at a site's knowledge check (SC-005). Created when the
/// worker reaches the check; `questionIds` is the sampled set, `answers` records
/// the per-question option chosen and how many tries it took (formative — the
/// worker corrects until all are right). Linked to the Submission once the
/// check-in is recorded. No FAILED status: an attempt is IN_PROGRESS or PASSED.
model KnowledgeCheckAttempt {
  id               String                @id @default(cuid())
  worker           Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId         String
  jobSite          JobSite               @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId        String
  bank             InductionQuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  bankId           String
  checklistVersion Int

  /// The check-in this attempt gated. Nullable (set when the submission is
  /// recorded); unique so an attempt backs at most one check-in.
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  submissionId String?     @unique

  questionIds Json //  string[] — the sampled question ids, in presentation order
  answers     Json @default("{}") // { [questionId]: { selectedOptionId, tries, correct } }

  status                 KnowledgeCheckAttemptStatus @default(IN_PROGRESS)
  questionCount          Int
  incorrectFirstTryCount Int                         @default(0)
  durationSeconds        Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workerId, startedAt])
  @@index([jobSiteId, status, completedAt])
}

/// A worker-reported flag on a knowledge-check question (SC-005) — the mockup's
/// "Flag question". Feeds the manager review list and question-quality reporting.
model QuestionFlag {
  id           String            @id @default(cuid())
  question     InductionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String
  workerId     String?
  submissionId String?
  reason       String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([questionId])
  @@index([resolvedAt])
}

/// A manager-granted authorisation for a worker to check in to a site while
/// OUTSIDE the GPS radius (SC-007). Server-authoritative: an out-of-range
/// check-in is only allowed when a matching override is still valid (not expired,
/// not yet used). A reason is mandatory (captured on the grant and copied onto
/// the resulting Submission) for audit. Single-use by default: `usedAt` is
/// stamped when consumed; an optional `expiresAt` time-boxes it.
model CheckInOverride {
  id        String  @id @default(cuid())
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  reason          String //   mandatory — why off-site check-in was authorised
  grantedByUserId String?
  grantedByName   String?

  expiresAt DateTime? // null = no expiry (still single-use)
  usedAt    DateTime? // set when a check-in consumes it
  revokedAt DateTime? // set if a manager cancels it before use

  createdAt DateTime @default(now())

  @@index([workerId, jobSiteId, usedAt])
  @@index([jobSiteId, createdAt])
}

/// SC-016 — a notification EVENT actually addressed to a person.
///
/// The rest of the notification framework DERIVES notifications from current data
/// on each read, which is right for state ("this is overdue") but cannot answer
/// "was this person told, and when". Assignment and meaningful-change
/// notifications are discrete occurrences, so they are STORED — that makes them
/// auditable, survives later edits to the action, and gives future reporting a
/// delivery record that could never be reconstructed after the fact.
///
/// V1 recipients are PLATFORM USERS only. Worker assignees are deliberately not
/// notified until worker-side action visibility exists (deferred from SC-015) —
/// notifying someone who has no way to open the action would be noise.
model NotificationEvent {
  id   String                @id @default(cuid())
  type NotificationEventType

  recipient       PlatformUser @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientUserId String

  action   Action? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String?

  /// Payload SNAPSHOT — what the person was told at the time. Deliberately not
  /// re-read from the action, so the record stays true if the action changes.
  title       String
  message     String
  siteName    String
  priority    String?
  dueDate     DateTime?
  description String?
  href        String
  /// Who caused it (denormalised so history survives user deletion).
  actorName   String?

  createdAt DateTime  @default(now())
  /// Set when the recipient opens/marks it read. Read state for these events is
  /// still ALSO tracked via NotificationRead so one mechanism drives the badge.
  readAt    DateTime?

  @@index([recipientUserId, createdAt])
  @@index([actionId])
}

/// SC-016 — the meaningful changes worth telling an assignee about. Deliberately
/// NOT every edit: a typo fix should not notify anyone.
enum NotificationEventType {
  ACTION_ASSIGNED
  ACTION_REASSIGNED
  ACTION_STATUS_CHANGED
  ACTION_PRIORITY_CHANGED
  ACTION_DUE_DATE_CHANGED
  /// SC-020 Phase 2 — an overdue compliance activity escalated. STORED rather
  /// than derived because "was management actually told, and when" is the whole
  /// point of an escalation, and a derived view can never answer it later.
  COMPLIANCE_ESCALATED
}

/// SC-019 — CDM 2015 duty holders for a project. These are legally structured
/// appointments (client, principal designer, principal contractor), not free
/// text, and they are distinct from the PRINCIPAL_CONTRACTOR platform ROLE: the
/// role is who logs in, this is the appointed organisation.
model CdmDutyHolders {
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String  @id

  clientName         String?
  clientContactName  String?
  clientContactEmail String?
  clientContactPhone String?

  principalDesigner            String?
  principalDesignerContact     String?
  principalDesignerEmail       String?
  principalDesignerPhone       String?
  principalDesignerAppointedAt DateTime?

  principalContractor            String?
  principalContractorContact     String?
  principalContractorEmail       String?
  principalContractorPhone       String?
  principalContractorAppointedAt DateTime?

  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// SC-019 — project-level detail for the Construction Phase Plan. Separate from
/// JobSite because JobSite is the operational record the worker flow depends on;
/// this is documentation metadata that must never risk that path.
model SiteProjectDetails {
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String  @id

  description    String?   @db.Text
  scopeOfWorks   String?   @db.Text
  startDate      DateTime?
  plannedEndDate DateTime?
  /// CDM 2015 F10 notifiable project (>30 working days with 20+ workers
  /// simultaneously, or >500 person days). Captured, NOT submitted — notifying
  /// the HSE remains the client's duty.
  cdmNotifiable  Boolean   @default(false)
  f10Reference   String?

  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// SC-019 — named site personnel. Generalises JobSite's single first-aider
/// fields to MULTIPLE first aiders, fire marshals and site managers. The single
/// JobSite fields are kept and treated as the primary entry, so every existing
/// worker-facing panel keeps working untouched.
model SiteKeyPerson {
  id        String            @id @default(cuid())
  jobSite   JobSite           @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String
  kind      SiteKeyPersonKind
  name      String
  phone     String?
  /// Where to find them, e.g. "Site Office".
  location  String?
  order     Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobSiteId, kind, order])
}

enum SiteKeyPersonKind {
  FIRST_AIDER
  FIRE_MARSHAL
  SITE_MANAGER
  OTHER
}

/// SC-019 — save-and-resume state for the setup wizard. The site is created from
/// a short mandatory core and every later step writes straight to the real
/// models, so this records only WHICH steps have been completed — it is progress
/// tracking, never a second copy of the data.
model SiteSetupProgress {
  jobSite        JobSite  @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId      String   @id
  /// Step keys the user has explicitly completed (see siteSetupConstants).
  completedSteps String[]
  /// Where to drop the user back in.
  lastStepKey    String?

  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// SC-020 Phase 1 — a recurring compliance activity.
///
/// v1 schedules AUDIT TEMPLATES, which means the template IS the activity type
/// ("Daily Safe Start", "Fire Point Check"...). No separate activity-type
/// catalogue is needed, and starting an occurrence creates a real audit so
/// SC-013 provenance and SC-014 scoring come along for free.
///
/// Reminder/escalation fields are captured in Phase 1 but ACTED ON in Phase 2 —
/// stored now so adding reminders later needs no migration.
model ComplianceSchedule {
  id        String  @id @default(cuid())
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  auditTemplate   AuditTemplate @relation(fields: [auditTemplateId], references: [id], onDelete: Cascade)
  auditTemplateId String
  /// Display title; defaults from the template but may be overridden per site.
  title           String

  frequency    ScheduleFrequency
  /// CUSTOM only: repeat every N days.
  intervalDays Int?
  /// WEEKLY (and weekday-limited DAILY): ISO weekdays, 1 = Monday .. 7 = Sunday.
  weekdays     Int[]
  /// MONTHLY: day of month 1-31, clamped to the month's length when generating.
  dayOfMonth   Int?
  /// Local time of day, "HH:MM" (Europe/London). The REV-1 chips all carry a
  /// time, so this is not a date-only schedule.
  timeOfDay    String            @default("08:00")

  startDate     DateTime
  endDate       DateTime?
  /// Days after the due date the activity may still be completed in.
  dueWindowDays Int       @default(1)

  assigneeKind           ScheduleAssigneeKind @default(ROLE)
  assignedPlatformUserId String?
  assignedWorkerId       String?
  assignedRole           PlatformRole?

  active      Boolean  @default(true)
  /// Generation is ACTIVATION-FORWARD: nothing is created before this instant,
  /// so switching on a schedule with a historic start date never backfills.
  activatedAt DateTime @default(now())

  /// Phase 2: days before due to remind, and the overdue escalation rule.
  reminderOffsetsDays Int[]
  escalateAfterDays   Int?
  escalateToRole      PlatformRole?

  createdByUserId String?
  createdByName   String?
  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occurrences ComplianceOccurrence[]

  @@index([jobSiteId, active])
  @@index([auditTemplateId])
}

/// SC-020 Phase 1 — one generated instance of a schedule.
///
/// `@@unique([scheduleId, dueAt])` is the IDEMPOTENCY guarantee: generation uses
/// createMany + skipDuplicates, so running it twice — or concurrently from two
/// requests — cannot double-generate. That matters more here than anywhere else
/// in the product: a duplicated or missing statutory inspection is a compliance
/// failure, not a cosmetic bug.
model ComplianceOccurrence {
  id         String             @id @default(cuid())
  schedule   ComplianceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String
  /// Denormalised so every calendar query is a single scoped read.
  jobSite    JobSite            @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId  String

  /// The due instant (UTC), and the Europe/London calendar date it belongs to.
  /// Storing the local date makes grouping into calendar cells an indexed
  /// equality rather than timezone arithmetic on every row.
  dueAt        DateTime
  dueDateLocal String
  timeOfDay    String

  status OccurrenceStatus @default(SCHEDULED)

  /// The audit created when someone starts this activity (SC-013/SC-014).
  audit   Audit?  @relation(fields: [auditId], references: [id], onDelete: SetNull)
  auditId String?

  /// Assignee SNAPSHOT at generation, so history survives later schedule edits.
  assigneeKind           ScheduleAssigneeKind
  assignedPlatformUserId String?
  assignedWorkerId       String?
  assignedRole           PlatformRole?
  assigneeLabel          String?

  /// SC-020 Phase 2 — set the FIRST time the escalation condition is observed,
  /// which both prevents re-escalating and drives the calendar's escalated
  /// marker. It records when we NOTICED, not when the activity became overdue;
  /// notifications always state "overdue since <due date>" so the real elapsed
  /// time is never obscured. Phase 4's scheduled trigger removes the lag.
  escalatedAt     DateTime?
  escalatedToRole PlatformRole?

  completedAt     DateTime?
  completedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, dueAt])
  @@index([jobSiteId, dueDateLocal])
  @@index([status, dueAt])
  @@index([escalatedAt, status])
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ScheduleAssigneeKind {
  USER
  WORKER
  ROLE
}

enum OccurrenceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
}

/// SC-020 Phase 4 — a record of each scheduled generation run.
///
/// Exists so a STALLED scheduler is visible rather than silent. A compliance
/// scheduler that quietly stops generating is the worst failure mode available:
/// nobody notices until an inspection has been missed. The calendar shows the
/// last successful run, so "nothing is due" and "nothing has been generated" can
/// never be mistaken for one another.
///
/// Lazy generation on calendar read is KEPT as a fallback and deliberately does
/// not write rows here — this table tracks the TRIGGER, so its newest row is a
/// truthful answer to "is the timer alive?".
model SchedulerRun {
  id      String           @id @default(cuid())
  trigger SchedulerTrigger

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  sitesConsidered     Int @default(0)
  occurrencesCreated  Int @default(0)
  escalationsRecorded Int @default(0)

  ok    Boolean @default(false)
  error String?

  @@index([trigger, startedAt])
}

enum SchedulerTrigger {
  /// The hourly Azure Functions timer — the primary trigger.
  TIMER
  /// A manual invocation of the same endpoint, for testing.
  MANUAL
}

/// SC-021 — per-site availability of a permit type.
///
/// OVERRIDES ONLY, mirroring SiteDashboardSetting (SC-003): a site with no row
/// for a type gets the default, which is AVAILABLE. That is what makes this
/// additive with no backfill — every existing site keeps exactly the behaviour
/// it has today until somebody deliberately turns something off.
///
/// Disabling governs NEW work only. Permits already raised stay visible,
/// completable and reportable, so a configuration change can never rewrite
/// history or strand an in-flight permit.
model SitePermitTypeSetting {
  id           String     @id @default(cuid())
  jobSite      JobSite    @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId    String
  permitType   PermitType @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  permitTypeId String
  enabled      Boolean

  /// Who last changed it (denormalised name so history survives user deletion).
  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobSiteId, permitTypeId])
  @@index([jobSiteId])
}

/// SC-021 — per-site availability of an activity type (an audit template, which
/// is what SC-020 schedules and SC-013 audits are both built from).
///
/// Same overrides-only rule as SitePermitTypeSetting. Disabling is blocked while
/// active compliance schedules still use the type on that site: silently
/// stopping scheduled inspections is the failure SC-020 Phase 4 exists to
/// prevent, so the conflict is surfaced and the manager decides.
model SiteActivityTypeSetting {
  id              String        @id @default(cuid())
  jobSite         JobSite       @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId       String
  auditTemplate   AuditTemplate @relation(fields: [auditTemplateId], references: [id], onDelete: Cascade)
  auditTemplateId String
  enabled         Boolean

  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobSiteId, auditTemplateId])
  @@index([jobSiteId])
}

/// SC-021 Phase 2 — how a template is labelled. The requirement lists project
/// templates, client-specific requirements and industry-specific templates as
/// three bullets; they are ONE mechanism — a reusable bundle of availability
/// settings — differing only in what the bundle represents. Modelling them as
/// three separate concepts would triple the code for no behavioural difference.
enum SiteConfigTemplateCategory {
  PROJECT_TYPE
  CLIENT
  INDUSTRY
  OTHER
}

/// SC-021 Phase 2 — a named, reusable bundle of per-site availability settings.
///
/// Applied with REPLACE semantics: applying a template produces the same
/// configuration regardless of what the site had before. Merge semantics would
/// make the outcome depend on prior state, which defeats the point of a
/// template.
model SiteConfigTemplate {
  id          String                     @id @default(cuid())
  name        String
  description String?
  category    SiteConfigTemplateCategory @default(PROJECT_TYPE)
  active      Boolean                    @default(true)

  createdByUserId String?
  createdByName   String?
  updatedByUserId String?
  updatedByName   String?

  items SiteConfigTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([active, category])
}

/// One decision inside a template. Exactly one of permitTypeId / auditTemplateId
/// is set — enforced by a CHECK constraint in the migration, because a row
/// pointing at both or neither is meaningless and would silently misapply.
model SiteConfigTemplateItem {
  id         String             @id @default(cuid())
  template   SiteConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  permitType   PermitType? @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  permitTypeId String?

  auditTemplate   AuditTemplate? @relation(fields: [auditTemplateId], references: [id], onDelete: Cascade)
  auditTemplateId String?

  enabled Boolean

  @@unique([templateId, permitTypeId])
  @@unique([templateId, auditTemplateId])
  @@index([templateId])
}

/// SC-021 Phase 2 — a company-wide MANDATORY service.
///
/// Row presence means mandatory. A mandatory service is forced ON when
/// availability is read and refused when a disable is attempted, mirroring
/// SC-003's locked Check-out panel: no configuration, however it was written,
/// can remove it. Template application cannot override it either.
model OrgServicePolicy {
  id String @id @default(cuid())

  permitType   PermitType? @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  permitTypeId String?     @unique

  auditTemplate   AuditTemplate? @relation(fields: [auditTemplateId], references: [id], onDelete: Cascade)
  auditTemplateId String?        @unique

  /// Why it is mandatory, shown to managers beside the lock. A rule without a
  /// stated reason reads as an obstruction.
  reason String?

  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// SC-022 Phase 1 — a per-(user, site, module) permission override.
///
/// NARROW-ONLY. `verbs` is the set of verbs the user keeps on that module for
/// that site, and the resolver intersects it with the role baseline, so an
/// override can never grant a capability the role does not already have. That
/// invariant is what stops permission configuration becoming a
/// privilege-escalation route, and it is enforced in the resolver rather than
/// trusted to each call site.
///
/// OVERRIDES ONLY: no row means the role baseline applies unchanged, so every
/// existing user keeps exactly the access they have today with no backfill.
///
/// `module` and `verbs` are stored as strings validated against PLATFORM_MODULES
/// and PERMISSION_VERBS rather than as database enums, so adding a module stays
/// a code change and never requires a migration to keep the two in step.
model SiteUserPermission {
  id             String       @id @default(cuid())
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformUserId String
  jobSite        JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId      String
  module         String
  /// The verbs retained. An EMPTY array means the module is hidden on this site.
  verbs          String[]

  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformUserId, jobSiteId, module])
  @@index([platformUserId])
  @@index([jobSiteId])
}

/// SC-022 Phase 1 — append-only record of every permission change.
///
/// "Audit user permissions" in the requirement. Names and the site name are
/// DENORMALISED so the history survives deletion of the user, the actor or the
/// site — an access-control audit trail that disappears when someone is removed
/// is worthless precisely when it is most needed.
///
/// This covers permission CHANGES. Access history (who viewed what) is a
/// separate, larger concern and is deliberately not attempted here.
model PermissionChangeLog {
  id String @id @default(cuid())

  actorUserId String?
  actorName   String

  targetUserId String?
  targetName   String
  targetRole   String

  jobSiteId   String?
  jobSiteName String

  /// NARROW | RESET | APPLY_PRESET | REVOKE_SITE
  action String
  module String?

  beforeVerbs String[]
  afterVerbs  String[]

  createdAt DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([jobSiteId, createdAt])
}

/// SC-022 Phase 2 — a reusable named set of permission restrictions.
///
/// Applied through the SAME narrow-only resolver as a manual override, so a
/// template is no more capable of granting access than a person is. It is a
/// shortcut for a decision, never a new source of authority.
model PermissionTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
  /// Seeded templates (Contractor (standard)). Kept so the library can stop a
  /// built-in being deleted out from under the UI that references it.
  isSystem    Boolean @default(false)

  createdByUserId String?
  createdByName   String?
  updatedByUserId String?
  updatedByName   String?

  items PermissionTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, name])
}

/// One module's retained verbs inside a template. An EMPTY array means the
/// module is removed entirely; NO ROW means the template says nothing about
/// that module and leaves it at the role baseline.
model PermissionTemplateItem {
  id         String             @id @default(cuid())
  template   PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  module     String
  verbs      String[]

  @@unique([templateId, module])
  @@index([templateId])
}

/// SC-022 Phase 2 — a company-wide permission floor.
///
/// A LIVE RULE, evaluated on every read, so it covers people hired after it was
/// set — a policy that silently skipped later joiners would not be a policy.
/// It is a FLOOR a site cannot loosen: the resolver intersects role ∩ company
/// default ∩ site override, so most restrictive wins and a Site Manager cannot
/// hand back what the company deliberately removed.
///
/// Matched on the PlatformUser.company STRING, which is free text — "ACME Ltd"
/// and "Acme Limited" are two different companies here. The UI therefore offers
/// a picker of values already in use and shows the matched user count before
/// saving, so a typo shows up as "0 users" rather than as a silently inert rule.
model CompanyPermissionDefault {
  id      String   @id @default(cuid())
  company String
  module  String
  verbs   String[]

  updatedByUserId String?
  updatedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([company, module])
  @@index([company])
}

/// Audit trail for outbound SMS.
///
/// PRIVACY: the message BODY is never stored. Bodies carry one-time sign-in
/// codes and invitation codes, so persisting them would turn this table into a
/// credential store and undo the point of one-time codes. What is kept is
/// enough to answer "was this sent, to whom, when, and did it work": purpose,
/// a masked destination, the provider's message id, and the outcome.
///
/// The destination is stored MASKED (+4477****4321) so the log is useful for
/// support without duplicating a full personal phone number outside the Worker
/// record. `workerId` is kept where known, so a full number can still be
/// reached through the proper record — and disappears with it on erasure.
model SmsMessageLog {
  id String @id @default(cuid())

  /// OTP | WORKER_INVITE | TEST | OTHER — what the message was for.
  purpose String

  /// Masked destination, e.g. "+4477****4321".
  toMasked String
  /// Set when the recipient is a known worker, so GDPR erasure reaches this row.
  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  workerId String?

  provider  String
  /// Provider message id (Twilio SID) where the send succeeded.
  messageId String?

  ok    Boolean
  /// Failure reason, already sanitised by the provider — never a credential.
  error String?

  /// Who triggered it, where a person did (an admin test, a manager invite).
  actorName String?

  jobSiteId String?

  createdAt DateTime @default(now())

  @@index([purpose, createdAt])
  @@index([workerId, createdAt])
  @@index([createdAt])
}

/// SC-023 — the lifecycle of a worker's access to one project.
///
/// INVITED    — invited, not yet approved. No access.
/// ACTIVE     — approved by an authorised user. Access granted.
/// SUSPENDED  — access withdrawn immediately, assignment retained.
/// REMOVED    — taken off the project. Kept for history, never deleted.
///
/// Phase 1 deliberately makes manager assignment + approval sufficient to grant
/// access. `acceptedAt` records that a worker accepted where they did, but is
/// NOT a gate: an undelivered SMS must never block a worker standing at the
/// gate whose manager has already approved them.
enum WorkerAssignmentStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

/// SC-023 — a worker's authorised access to one project.
///
/// The missing spine: before this, a worker's relationship to a site was merely
/// "they checked in once", so there was nothing for an invitation, approval or
/// suspension to attach to.
model WorkerSiteAssignment {
  id        String  @id @default(cuid())
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  jobSite   JobSite @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  jobSiteId String

  status WorkerAssignmentStatus @default(INVITED)

  /// Short code a manager can read out when SMS cannot be delivered. Site huts
  /// have poor signal; a flow that only works with a delivered message fails on
  /// a real site, so this is a permanent feature and not test scaffolding.
  invitationCode String?

  invitedByUserId String?
  invitedByName   String?
  invitedAt       DateTime @default(now())

  /// Recorded when the worker accepts. Informational in Phase 1 — see the enum.
  acceptedAt DateTime?

  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?

  suspendedAt     DateTime?
  suspendedByName String?
  removedAt       DateTime?

  /// True when created by the SC-023 backfill rather than a real invitation, so
  /// "how did this person get access?" stays answerable afterwards.
  backfilled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, jobSiteId])
  @@index([jobSiteId, status])
  @@index([workerId, status])
}

/// SC-023 — append-only record of every access decision.
///
/// "Audit who granted access and when." NO foreign keys and denormalised names,
/// following SC-022's PermissionChangeLog: an access-control trail that
/// disappears when the worker or the site is deleted is worthless precisely
/// when it is most needed.
model WorkerAssignmentEvent {
  id String @id @default(cuid())

  workerId   String?
  workerName String
  jobSiteId  String?
  siteName   String

  /// INVITED | APPROVED | SUSPENDED | REINSTATED | REMOVED | ACCEPTED |
  /// ENFORCEMENT_ON | ENFORCEMENT_OFF | BACKFILLED
  action String
  /// Free-text detail, e.g. why access was refused or who reinstated it.
  detail String?

  actorName String

  createdAt DateTime @default(now())

  @@index([jobSiteId, createdAt])
  @@index([workerId, createdAt])
}
